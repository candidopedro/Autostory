# Porta do servidor
PORT=3000

# URL pública do site (HTTPS). O Instagram baixa as imagens geradas por esta URL,
# então ela precisa ser acessível pela internet (ex.: https://autostory.seudominio.com).
PUBLIC_BASE_URL=http://localhost:3000

# Webhook do fluxo n8n (n8n/autostory-workflow.json) — use a "Production URL" do nó Webhook
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/autostory
# Opcional: segredo enviado no header X-Autostory-Secret (configure o mesmo valor no nó "Validar" do n8n)
N8N_WEBHOOK_SECRET=

# App da Meta com o produto "Instagram API with Instagram Login"
IG_APP_ID=
IG_APP_SECRET=
# Opcional (padrão: PUBLIC_BASE_URL/auth/instagram/callback). Cadastre a mesma URL no app da Meta.
IG_REDIRECT_URI=

# Apenas para testes locais: cria um login falso quando IG_APP_ID está vazio
DEV_FAKE_LOGIN=0
