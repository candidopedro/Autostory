{
  "name": "Autostory - Postar story no Instagram",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "autostory",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook Autostory",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "autostory"
    },
    {
      "parameters": {
        "jsCode": "// Troque pelo mesmo valor de N8N_WEBHOOK_SECRET do .env do Autostory (ou deixe vazio para não validar)\nconst SECRET = '';\n\nconst req = $input.first().json;\nconst body = req.body || {};\nif (SECRET && req.headers['x-autostory-secret'] !== SECRET) {\n  throw new Error('Segredo do webhook inválido');\n}\nconst ig = body.instagram || {};\nif (!ig.userId || !ig.accessToken) throw new Error('Credenciais do Instagram ausentes');\nconst images = (body.images || []).slice(0, 10);\nif (!images.length) throw new Error('Nenhuma imagem recebida');\n\nreturn images.map((url, i) => ({ json: { index: i, imageUrl: url, userId: ig.userId, accessToken: ig.accessToken } }));"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Validar e separar imagens",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.instagram.com/v21.0/{{ $json.userId }}/media",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "image_url", "value": "={{ $json.imageUrl }}" },
            { "name": "media_type", "value": "STORIES" },
            { "name": "access_token", "value": "={{ $json.accessToken }}" }
          ]
        },
        "options": { "batching": { "batch": { "batchSize": 1, "batchInterval": 500 } } }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Criar container do story",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": { "amount": 8 },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Aguardar processamento",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [660, 300],
      "webhookId": "autostory-wait"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.instagram.com/v21.0/{{ $('Validar e separar imagens').item.json.userId }}/media_publish",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "creation_id", "value": "={{ $json.id }}" },
            { "name": "access_token", "value": "={{ $('Validar e separar imagens').item.json.accessToken }}" }
          ]
        },
        "options": { "batching": { "batch": { "batchSize": 1, "batchInterval": 1500 } } }
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Publicar story",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ids = $input.all().map(i => i.json.id).filter(Boolean);\nreturn [{ json: { ok: true, posted: ids.length, mediaIds: ids } }];"
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Resumo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Responder ao Autostory",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1320, 300]
    }
  ],
  "connections": {
    "Webhook Autostory": { "main": [[{ "node": "Validar e separar imagens", "type": "main", "index": 0 }]] },
    "Validar e separar imagens": { "main": [[{ "node": "Criar container do story", "type": "main", "index": 0 }]] },
    "Criar container do story": { "main": [[{ "node": "Aguardar processamento", "type": "main", "index": 0 }]] },
    "Aguardar processamento": { "main": [[{ "node": "Publicar story", "type": "main", "index": 0 }]] },
    "Publicar story": { "main": [[{ "node": "Resumo", "type": "main", "index": 0 }]] },
    "Resumo": { "main": [[{ "node": "Responder ao Autostory", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
